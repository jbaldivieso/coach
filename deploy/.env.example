# Coach Production Environment
# Copy this to .env and customize
#
# Generate a secret key with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-secure-key-here

DJANGO_ALLOWED_HOSTS=coach.baldivieso.com
CORS_ALLOWED_ORIGINS=https://coach.baldivieso.com
CSRF_TRUSTED_ORIGINS=https://coach.baldivieso.com

# The address people and Claude reach the site at, used in the OAuth and MCP
# metadata. Required when DJANGO_DEBUG=False: the server won't start without it.
COACH_PUBLIC_URL=https://coach.baldivieso.com
